<Window x:Class="PDFKawankasi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PDFKawankasi.ViewModels"
        xmlns:local="clr-namespace:PDFKawankasi.Views"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="PDF Kawankasi - Privacy-First PDF Toolkit"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Icon="/Assets/icon.png">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar with Menu Bar -->
        <Grid x:Name="CustomTitleBar" Grid.Row="0" Background="{StaticResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- App Icon -->
            <Viewbox Grid.Column="0" 
                     Width="20" Height="20"
                     Margin="12,0,8,0"
                     VerticalAlignment="Center">
                <Image Source="/Assets/icon.png"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform"/>
            </Viewbox>
            
            <!-- App Title -->
            <TextBlock Grid.Column="2"
                       Text="PDF Kawankasi"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            
            <!-- Menu Bar (merged into title bar) -->
            <Menu x:Name="AppMenuBar" Grid.Column="3"
                  Background="Transparent"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  VerticalAlignment="Center"
                  WindowChrome.IsHitTestVisibleInChrome="True">
                
                <!-- File Menu -->
                <MenuItem Header="_File">
                    <MenuItem Header="Open" Command="{Binding DataContext.OpenPdfCommand, RelativeSource={RelativeSource AncestorType=Grid}}" InputGestureText="Ctrl+O" ToolTip="Open a PDF file"/>
                    <MenuItem Header="Save" Command="{Binding DataContext.SavePdfCommand, RelativeSource={RelativeSource AncestorType=Grid}}" InputGestureText="Ctrl+S" ToolTip="Save the current PDF"/>
                    <MenuItem Header="Save As" Command="{Binding DataContext.SaveAsPdfCommand, RelativeSource={RelativeSource AncestorType=Grid}}" InputGestureText="Ctrl+Shift+S" ToolTip="Save the PDF with a new name"/>
                    <Separator/>
                    <MenuItem Header="Register as Default PDF Viewer" Click="RegisterAsDefaultPdfViewer_Click" ToolTip="Set PDF Kawankasi as your default PDF viewer"/>
                    <Separator/>
                    <MenuItem Header="Export" Command="{Binding DataContext.ExportPdfCommand, RelativeSource={RelativeSource AncestorType=Grid}}" ToolTip="Export PDF to various formats"/>
                    <!-- Use click handler to reliably reach the active PDF editor tab -->
                    <MenuItem Header="Print"
                              Click="PrintMenuItem_Click"
                              InputGestureText="Ctrl+P"
                              ToolTip="Print the current document"/>
                </MenuItem>
                
                <!-- Tools Menu -->
                <MenuItem Header="_Tools">
                    <MenuItem Header="Merge PDF" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.MergePdf}"/>
                    <MenuItem Header="Split PDF" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.SplitPdf}"/>
                    <MenuItem Header="Compress PDF" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.CompressPdf}"/>
                    <Separator/>
                    <MenuItem Header="Extract Pages" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.ExtractPages}"/>
                    <MenuItem Header="Delete Pages" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.DeletePages}"/>
                    <MenuItem Header="Rotate PDF" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.RotatePdf}"/>
                </MenuItem>
                
                <!-- Edit Menu -->
                <MenuItem Header="_Edit">
                    <MenuItem Header="Add Page Numbers" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.AddPageNumbers}"/>
                    <MenuItem Header="Add Watermark" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.AddWatermark}"/>
                    <MenuItem Header="Invert Colors" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.InvertColors}"/>
                    <MenuItem Header="Change Background Colors" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.BackgroundColor}"/>
                    <MenuItem Header="Remove Annotations" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.RemoveAnnotations}"/>
                </MenuItem>
                
                <!-- Image Menu -->
                <MenuItem Header="_Image">
                    <MenuItem Header="Image to PDF" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.ImageToPdf}"/>
                    <MenuItem Header="PDF to Image" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.PdfToJpg}"/>
                    <MenuItem Header="PDF to Grayscale" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.PdfToGreyscale}"/>
                </MenuItem>
                
                <!-- Metadata Menu -->
                <MenuItem Header="_Metadata">
                    <MenuItem Header="View Metadata" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.ViewMetadata}"/>
                    <MenuItem Header="Edit Metadata" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static local:ToolsMenuHelper.EditMetadata}"/>
                </MenuItem>
            </Menu>
            
            <!-- Drag Region (empty space for dragging window) -->
            <Border Grid.Column="4" Background="Transparent"/>
            
            <!-- Window Control Buttons -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" 
                       WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton"
                        Content="&#xE921;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Width="46" Height="32"
                        Background="Transparent"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0"
                        Click="MinimizeButton_Click"
                        ToolTip="Minimize"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource CardBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="MaximizeRestoreButton"
                        Content="&#xE922;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Width="46" Height="32"
                        Background="Transparent"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0"
                        Click="MaximizeRestoreButton_Click"
                        ToolTip="Maximize"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource CardBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="CloseButton"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Width="46" Height="32"
                        Background="Transparent"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        ToolTip="Close"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area - PDF Editor Only -->
        <Grid Grid.Row="1">
            <!-- Tools Grid View (hidden by default, PDF Editor is default) -->
            <!--<ScrollViewer x:Name="ToolsScrollViewer"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24">
                <ItemsControl ItemsSource="{Binding FilteredCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,24">
                                --><!-- Category Header --><!--
                                <TextBlock Text="{Binding Name}" 
                                           Style="{StaticResource CategoryHeaderStyle}"/>
                                
                                --><!-- Tools in this category --><!--
                                <ItemsControl ItemsSource="{Binding Tools}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ToolCardStyle}"
                                                    Command="{Binding DataContext.SelectToolCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Width="180" Height="140"
                                                    Margin="0,0,12,12">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}" 
                                                               FontSize="32" 
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding Name}" 
                                                               Style="{StaticResource ToolNameStyle}"/>
                                                    <TextBlock Text="{Binding Subtitle}" 
                                                               Style="{StaticResource ToolSubtitleStyle}"
                                                               MaxWidth="160"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
