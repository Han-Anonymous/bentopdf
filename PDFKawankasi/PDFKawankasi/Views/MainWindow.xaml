                </ItemsControl>
            </ScrollViewer>-->

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Split PDF Preview View -->
                <Grid Grid.Row="1" 
          Visibility="{Binding IsSplitPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- File Info and Options -->
                    <Border Grid.Row="0" 
                Background="{StaticResource CardBrush}" 
                CornerRadius="8" 
                Padding="16" 
                Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- File Info -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📄" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedFiles[0]}" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="400"/>
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                            <Run Text="{Binding PagePreviews.Count, Mode=OneWay}"/>
                            <Run Text="pages"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Change File Button -->
                            <Button Grid.Column="1" 
                        Content="📂 Change File"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnBrowseFilesClick"
                        Padding="16,10"/>
                        </Grid>
                    </Border>

                    <!-- Page Previews Grid -->
                    <Border Grid.Row="1" 
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="2"
                CornerRadius="12"
                Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Selection Controls -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="Select pages to split:" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,24,0"/>
                                <Button Content="Select All"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SelectAllPagesCommand}"
                            Padding="12,6"
                            Margin="0,0,8,0"/>
                                <Button Content="Deselect All"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeselectAllPagesCommand}"
                            Padding="12,6"/>
                            </StackPanel>

                            <!-- Pages Grid -->
                            <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding PagePreviews}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="PageCard"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Width="120"
                                        Height="160"
                                        Margin="0,0,12,12"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="OnPagePreviewClick">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                                <Setter Property="Background" Value="#2D3748"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Page Icon/Preview -->
                                                    <Border Grid.Row="0" 
                                                Background="{StaticResource CardBrush}"
                                                CornerRadius="4"
                                                Margin="8,8,8,4">
                                                        <Grid>
                                                            <!-- Thumbnail Image (shown when available) -->
                                                            <Image Source="{Binding Thumbnail}" 
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Thumbnail, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                            <!-- Fallback Page Icon (shown when no thumbnail) -->
                                                            <TextBlock Text="📄" 
                                                           FontSize="40" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"
                                                           Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibleConverter}}"/>
                                                            <!-- Selection Checkbox Indicator -->
                                                            <Border HorizontalAlignment="Right" 
                                                        VerticalAlignment="Top"
                                                        Margin="0,-4,-4,0"
                                                        Width="24"
                                                        Height="24"
                                                        CornerRadius="12"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
                                                                </Border.Background>
                                                                <TextBlock Text="✓" 
                                                               Foreground="White" 
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Page Number -->
                                                    <TextBlock Grid.Row="1" 
                                                   Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   Margin="4,4,4,8"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Split Options -->
                    <Border Grid.Row="2" 
                Background="{StaticResource CardBrush}" 
                CornerRadius="8" 
                Padding="16" 
                Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Split Options:" 
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SingleFileRadio"
                                 GroupName="SplitMode"
                                 IsChecked="{Binding SplitMode, Converter={StaticResource SplitModeToSingleFileConverter}}"
                                 Margin="0,0,24,0"
                                 Foreground="{StaticResource TextPrimaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Single PDF file" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SeparateFilesRadio"
                                 GroupName="SplitMode"
                                 IsChecked="{Binding SplitMode, Converter={StaticResource SplitModeToSeparateFilesConverter}}"
                                 Foreground="{StaticResource TextPrimaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="Separate files (one per page)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- PDF Editor View - Always Visible -->
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab Control Header Area -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="0"/>

                    <!-- PDF Editor Tab Control with New Tab Button -->
                <TabControl Grid.Row="1"
                            x:Name="PdfTabControl"
                            Background="{StaticResource BackgroundBrush}"
                            BorderThickness="0"
                            Padding="0">
                    <TabControl.Resources>
                        <!-- TabItem Style -->
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBorder"
                                                Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1,1,1,0"
                                                CornerRadius="6,6,0,0"
                                                Padding="8,4"
                                                Margin="2,0,0,0"
                                                AllowDrop="True"
                                                MouseMove="OnTabMouseMove"
                                                Drop="OnTabDrop"
                                                DragEnter="OnTabDragEnter"
                                                DragLeave="OnTabDragLeave"
                                                MouseLeftButtonDown="OnTabMouseDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Content.DataContext.DocumentTitle, RelativeSource={RelativeSource TemplatedParent}, FallbackValue='New Document'}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="180"
                                                           Margin="0,0,8,0"/>
                                                <Button Grid.Column="1"
                                                        Content="✕"
                                                        FontSize="11"
                                                        Padding="4,2"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        Cursor="Hand"
                                                        Click="OnTabCloseClick"
                                                        Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Opacity" Value="0.6"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            </Trigger>
                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- ItemsPanel - Define horizontal TabPanel for tab headers -->
                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>

                    <!-- Custom Template with Add Tab Button -->
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Tab Header Panel with Add Button -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{StaticResource BackgroundBrush}">
                                    <!-- Tab Items Container -->
                                    <ItemsPresenter/>
                                    
                                    <!-- New Tab Button (Browser Style) -->
                                    <Button Content="+"
                                            Click="OnNewTabClick"
                                            ToolTip="New tab (Ctrl+T)"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            FontSize="18"
                                            FontWeight="Normal"
                                            Padding="8,4"
                        Margin="4,0,4,0"
                        Cursor="Hand"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                </StackPanel>
                                
                                <!-- Tab Content Area -->
                                <Border Grid.Row="1"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1,0,1,1"
                                        CornerRadius="0,0,8,8"
                                        Padding="0">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      Content="{TemplateBinding SelectedContent}"
                                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- Default Tab -->
                    <TabItem Header="Document 1">
                        <Grid Focusable="True"
                              PreviewKeyDown="PdfEditor_OnPreviewKeyDown"
                              PreviewKeyUp="PdfEditor_OnPreviewKeyUp"
                              PreviewMouseWheel="PdfEditor_OnPreviewMouseWheel">
                            <Grid.DataContext>
                                <vm:PdfEditorViewModel/>
                            </Grid.DataContext>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                            
                                    <!-- Compact Toolbar (merged with navigation) -->
                                    <Border Grid.Row="0" 
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                            
                                            <!-- Left side: File Actions, Undo/Redo, and Clear -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding OpenPdfCommand}"
                                                        ToolTip="Open a PDF file (Ctrl+O)"
                                                        Padding="8,4"
                                                        Margin="0,0,4,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{svgc:SvgImage /Assets/PDF Editor/files.svg}" Width="16" Height="16" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Open"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding SavePdfCommand}"
                                                        ToolTip="Save to original file (Ctrl+S)"
                                                        Padding="8,4"
                                                        Margin="0,0,4,0"
                                                        IsEnabled="{Binding IsPdfLoaded}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{svgc:SvgImage /Assets/PDF Editor/diskette.svg}" Width="16" Height="16" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Save"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding SavePdfAsCommand}"
                                                        ToolTip="Save to a new file (Ctrl+Shift+S)"
                                                        Padding="8,4"
                                                        Margin="0,0,4,0"
                                                        IsEnabled="{Binding IsPdfLoaded}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{svgc:SvgImage /Assets/PDF Editor/diskette.svg}" Width="16" Height="16" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Save As"/>
                                                    </StackPanel>
                                                </Button>
                                                <!-- Open saved file hyperlink -->
                                                <Button Content="📁 Open Saved"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding OpenSavedFileCommand}"
                                                        ToolTip="{Binding LastSavedFilePath}"
                                                        Padding="8,4"
                                                        Margin="0,0,4,0"
                                                        Visibility="{Binding HasLastSavedFile, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            
                                                <Separator Margin="8,0"/>
                            
                                                <!-- Undo/Redo Buttons -->
                                                <Button Content="↩"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding UndoCommand}"
                                                        ToolTip="Undo (Ctrl+Z)"
                                                        Padding="10,4"
                                                        Margin="0,0,2,0"
                                                        IsEnabled="{Binding CanUndo}"/>
                                                <Button Content="↪"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding RedoCommand}"
                                                        ToolTip="Redo (Ctrl+Y)"
                                                        Padding="10,4"
                                                        Margin="0,0,4,0"
                                                        IsEnabled="{Binding CanRedo}"/>
                            
                                            </StackPanel>
                            
                                            <!-- Center: Annotation Tools -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <!-- Select Tool -->
                                                <ToggleButton x:Name="SelectToolBtn"
                                                              Content="👆"
                                                              ToolTip="Select/Move"
                                                              Style="{StaticResource ToolToggleButtonStyle}"
                                                              IsChecked="{Binding IsSelectToolActive}"
                                                              IsEnabled="{Binding IsPdfLoaded}"
                                                              Padding="6,4"
                                                              Margin="0,0,2,0"/>
                            
                                                <!-- Highlight Tool with SVG -->
                                                <ToggleButton x:Name="HighlightToolBtn"
                                                              ToolTip="Highlight text (Hold Shift for straight line)"
                                                              Style="{StaticResource ToolToggleButtonStyle}"
                                                              IsChecked="{Binding IsHighlightToolActive}"
                                                              IsEnabled="{Binding IsPdfLoaded}"
                                                              Padding="6,4"
                                                              Margin="0,0,2,0">
                                                    <Image Source="{svgc:SvgImage /Assets/PDF Editor/Highlighter.svg}" Width="18" Height="18"/>
                                                </ToggleButton>
                            
                                                <!-- Draw Tool with SVG -->
                                                <ToggleButton x:Name="DrawToolBtn"
                                                              ToolTip="Free-hand draw (Hold Shift for straight line)"
                                                              Style="{StaticResource ToolToggleButtonStyle}"
                                                              IsChecked="{Binding IsDrawToolActive}"
                                                              IsEnabled="{Binding IsPdfLoaded}"
                                                              Padding="6,4"
                                                              Margin="0,0,2,0">
                                                    <Image Source="{svgc:SvgImage /Assets/PDF Editor/Pen.svg}" Width="18" Height="18"/>
                                                </ToggleButton>
                            
                                                <!-- Erase Tool with SVG -->
                                                <ToggleButton x:Name="EraseToolBtn"
                                                              ToolTip="Erase ink strokes"
                                                              Style="{StaticResource ToolToggleButtonStyle}"
                                                              IsEnabled="{Binding IsPdfLoaded}"
                                                              Padding="6,4"
                                                              Margin="0,0,2,0"
                                                              Click="OnEraseToolClick">
                                                    <Image Source="{svgc:SvgImage /Assets/PDF Editor/Eraser.svg}" Width="18" Height="18"/>
                                                </ToggleButton>
                            
                                                <!-- Text Tool -->
                                                <ToggleButton x:Name="TextToolBtn"
                                                              Content="📝"
                                                              ToolTip="Add text annotation"
                                                              Style="{StaticResource ToolToggleButtonStyle}"
                                                              IsChecked="{Binding IsTextToolActive}"
                                                              IsEnabled="{Binding IsPdfLoaded}"
                                                              Padding="6,4"
                                                              Margin="0,0,2,0"/>
                            
                                                <!-- Shape Tool with SVG -->
                                                <ToggleButton x:Name="ShapeToolBtn"
                                                              ToolTip="Add shapes"
                                                              Style="{StaticResource ToolToggleButtonStyle}"
                                                              IsChecked="{Binding IsShapeToolActive}"
                                                              IsEnabled="{Binding IsPdfLoaded}"
                                                              Padding="6,4"
                                                              Margin="0,0,2,0">
                                                    <Image Source="{svgc:SvgImage /Assets/PDF Editor/Add Shape.svg}" Width="18" Height="18"/>
                                                </ToggleButton>
                            
                                                <!-- Comment Tool with SVG -->
                                                <ToggleButton x:Name="CommentToolBtn"
                                                              ToolTip="Add comment (click to expand/collapse)"
                                                              Style="{StaticResource ToolToggleButtonStyle}"
                                                              IsChecked="{Binding IsCommentToolActive}"
                                                              IsEnabled="{Binding IsPdfLoaded}"
                                                              Padding="6,4"
                                                              Margin="0,0,2,0">
                                                    <Image Source="{svgc:SvgImage /Assets/PDF Editor/Add Comment.svg}" Width="18" Height="18"/>
                                                </ToggleButton>
                            
                                                <!-- Image Tool with SVG - Opens file picker immediately -->
                                                <Button x:Name="ImageToolBtn"
                                                        ToolTip="Add image (opens file picker)"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        IsEnabled="{Binding IsPdfLoaded}"
                                                        Padding="6,4"
                                                        Margin="0,0,2,0"
                                                        Click="OnAddImageClick">
                                                    <Image Source="{svgc:SvgImage /Assets/PDF Editor/Add Image.svg}" Width="18" Height="18"/>
                                                </Button>
                            
                                                <!-- Redact Tool -->
                                                <ToggleButton x:Name="RedactToolBtn"
                                                              Content="█"
                                                              ToolTip="Redact/Black out content"
                                                              Style="{StaticResource ToolToggleButtonStyle}"
                                                              IsChecked="{Binding IsRedactToolActive}"
                                                              IsEnabled="{Binding IsPdfLoaded}"
                                                              Padding="6,4"
                                                              Margin="0,0,2,0"
                                                              Foreground="{StaticResource DangerBrush}"/>
                            
                                                <Separator Margin="8,0"/>
                            
                                                <!-- Color Picker -->
                                                <Border Width="24" Height="24" 
                                                        CornerRadius="4"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="2"
                                                        Cursor="Hand"
                                                        Margin="0,0,4,0"
                                                        MouseLeftButtonUp="OnColorPickerClick">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding SelectedColor}"/>
                                                    </Border.Background>
                                                </Border>
                            
                                                <!-- Pen Thickness Slider -->
                                                <Slider Width="60"
                                                        Minimum="1"
                                                        Maximum="20"
                                                        Value="{Binding PenThickness}"
                                                        ToolTip="{Binding PenThickness, StringFormat=Thickness: {0:F1}px}"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding IsPdfLoaded}"/>
                                            </StackPanel>
                            
                                            <!-- Right side: Zoom, Page Nav, View Controls -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <!-- Panel toggles -->
                                                <Button Content="◀"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding ToggleLeftPanelCommand}"
                                                        ToolTip="Toggle pages panel"
                                                        Padding="6,4"
                                                        Margin="0,0,2,0"/>
                            
                            
                                                <Separator Margin="4,0"/>
                            
                                                <!-- Zoom controls with SVG icons -->
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding ZoomOutCommand}"
                                                        ToolTip="Zoom out (Ctrl+-)"
                                                        Padding="6,4"
                                                        Margin="0,0,2,0"
                                                        IsEnabled="{Binding IsPdfLoaded}">
                                                    <Image Source="{svgc:SvgImage /Assets/PDF Editor/Zoom Out.svg}" Width="16" Height="16"/>
                                                </Button>
                                                <TextBlock Text="{Binding ZoomLevel, StringFormat={}{0:P0}}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Width="40"
                                                           TextAlignment="Center"
                                                           FontSize="11"/>
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding ZoomInCommand}"
                                                        ToolTip="Zoom in (Ctrl++)"
                                                        Padding="6,4"
                                                        Margin="0,0,2,0"
                                                        IsEnabled="{Binding IsPdfLoaded}">
                                                    <Image Source="{svgc:SvgImage /Assets/PDF Editor/Zoom In.svg}" Width="16" Height="16"/>
                                                </Button>
                            
                                                <!-- Fit buttons with SVG icons -->
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        ToolTip="Fit page width to screen"
                                                        Padding="6,4"
                                                        Margin="0,0,2,0"
                                                        IsEnabled="{Binding IsPdfLoaded}"
                                                        Click="OnFitToWidthClick">
                                                    <Image Source="{svgc:SvgImage /Assets/PDF Editor/Fit Screen Width.svg}" Width="16" Height="16"/>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        ToolTip="Fit entire page to screen"
                                                        Padding="6,4"
                                                        Margin="0,0,2,0"
                                                        IsEnabled="{Binding IsPdfLoaded}"
                                                        Click="OnFitToPageClick">
                                                    <Image Source="{svgc:SvgImage /Assets/PDF Editor/Fit Whole Page Content to screen.svg}" Width="16" Height="16"/>
                                                </Button>
                            
                                                <!-- Continuous scroll toggle -->
                                                <ToggleButton Content="📜"
                                                              Style="{StaticResource ToolToggleButtonStyle}"
                                                              IsChecked="{Binding IsContinuousScrollMode}"
                                                              ToolTip="Continuous scrolling mode"
                                                              Padding="6,4"
                                                              Margin="0,0,2,0"
                                                              IsEnabled="{Binding IsPdfLoaded}"/>
                            
                                                <!-- Dual page toggle -->
                                                <ToggleButton Content="📖"
                                                              Style="{StaticResource ToolToggleButtonStyle}"
                                                              IsChecked="{Binding IsDualPageMode}"
                                                              ToolTip="Dual page view"
                                                              Padding="6,4"
                                                              Margin="0,0,4,0"
                                                              IsEnabled="{Binding IsPdfLoaded}"/>
                            
                                                <!-- Fullscreen toggle -->
                                                <Button Content="⛶"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding ToggleFullscreenCommand}"
                                                        ToolTip="Toggle fullscreen (F11)"
                                                        Padding="6,4"
                                                        Margin="0,0,4,0"/>
                            
                                                <Separator Margin="4,0"/>
                            
                                                <!-- Page Navigation -->
                                                <Button Content="◀"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding PreviousPageCommand}"
                                                        ToolTip="Previous page"
                                                        Padding="6,4"
                                                        Margin="0,0,2,0"
                                                        IsEnabled="{Binding CanGoPrevious}"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="11">
                                                    <Run Text="{Binding CurrentPage}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Run Text="/" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <Run Text="{Binding TotalPages}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </TextBlock>
                                                <Button Content="▶"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding NextPageCommand}"
                                                        ToolTip="Next page"
                                                        Padding="6,4"
                                                        Margin="2,0,0,0"
                                                        IsEnabled="{Binding CanGoNext}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                            
                                    <!-- Main Content Area -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="LeftPanelColumn" Width="180">
                                                <ColumnDefinition.Style>
                                                    <Style TargetType="ColumnDefinition">
                                                        <Setter Property="Width" Value="180"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLeftPanelVisible}" Value="False">
                                                                <Setter Property="Width" Value="0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ColumnDefinition.Style>
                                            </ColumnDefinition>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                            
                                        <!-- Page Thumbnails Panel (Collapsible) -->
                                        <Border Grid.Column="0" 
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,1,0"
                                                Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                            
                                                <TextBlock Grid.Row="0" 
                                                           Text="Pages"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Padding="8"/>
                            
                                                <ScrollViewer Grid.Row="1" 
                                                              VerticalScrollBarVisibility="Auto"
                                                              Padding="4">
                                                    <ItemsControl ItemsSource="{Binding PageThumbnails}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="White"
                                                                        BorderThickness="2"
                                                                        CornerRadius="4"
                                                                        Margin="0,0,0,6"
                                                                        Cursor="Hand"
                                                                        MouseLeftButtonUp="OnThumbnailClick"
                                                                        MouseRightButtonUp="OnThumbnailRightClick">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Add Page Above" Click="OnAddPageAboveClick"/>
                                                                            <MenuItem Header="Add Page Below" Click="OnAddPageBelowClick"/>
                                                                            <Separator/>
                                                                            <MenuItem Header="Insert Above - PDF Page(s)" Click="OnInsertPdfPagesAboveClick"/>
                                                                            <MenuItem Header="Insert Below - PDF Page(s)" Click="OnInsertPdfPagesBelowClick"/>
                                                                            <Separator/>
                                                                            <MenuItem Header="Delete Page" Click="OnDeletePageClick" Foreground="{StaticResource DangerBrush}"/>
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>
                                                                    <Grid>
                                                                        <!-- Selection checkbox overlay -->
                                                                        <Border Background="#80000000"
                                                                                CornerRadius="2"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Top"
                                                                                Padding="2"
                                                                                Margin="4"
                                                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock Text="✓" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                        </Border>
                                                                        <Image Source="{Binding Thumbnail}" 
                                                                               Stretch="Uniform"
                                                                               MaxHeight="120"
                                                                               Margin="2"
                                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        <TextBlock Text="{Binding PageNumber}"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                   Background="{StaticResource SurfaceBrush}"
                                                                                   Padding="2,1"
                                                                                   FontSize="10"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Bottom"
                                                                                   Margin="2"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                            
                                                <!-- Empty State -->
                                                <TextBlock Grid.Row="2"
                                                           Text="Open a PDF to view pages"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Padding="8"
                                                           Visibility="{Binding IsPdfLoaded, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                            
                                        <GridSplitter Grid.Column="1" 
                                                      Width="4"
                                                      Background="Transparent"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Stretch"
                                                      Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            
                                        <!-- PDF Canvas/Viewer Area -->
                                        <Grid Grid.Column="2" 
                                              Background="{StaticResource CardBrush}">
                                            
                                            <!-- Single Page View (default mode) -->
                                            <ScrollViewer x:Name="PdfScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              ScrollChanged="OnScrollChanged"
                                              Visibility="{Binding IsSinglePageMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="White">
                                                    <!-- PDF Page Image as background -->
                                                    <Image x:Name="PdfPageImage"
                                               Source="{Binding CurrentPageImage}"
                                               Stretch="Fill"/>
                            
                                                    <!-- Windows InkCanvas for native stylus/pen/touch support -->
                                                    <InkCanvas x:Name="PdfInkCanvas"
                                                   Background="Transparent"
                                                   Width="{Binding CanvasWidth}"
                                                   Height="{Binding CanvasHeight}"
                                                   EditingMode="{Binding InkEditingMode}"
                                                   DefaultDrawingAttributes="{Binding InkDrawingAttributes}"
                                                   StrokeCollected="OnInkStrokeCollected"
                                                   StrokeErasing="OnInkStrokeErasing"
                                                   MouseLeftButtonDown="OnInkCanvasMouseDown"
                                                   MouseLeftButtonUp="OnInkCanvasMouseUp"
                                                   MouseMove="OnInkCanvasMouseMove">
                                                        <!-- Existing non-ink annotations overlay -->
                                                        <InkCanvas.Children>
                                                            <ItemsControl ItemsSource="{Binding CurrentPageAnnotations}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style>
                                                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <!-- Comment callout icon (Adobe-style) - clickable to expand -->
                                                                            <Border Cursor="Hand"
                                                                        MouseLeftButtonUp="OnCommentCalloutClick"
                                                                        Background="#FFF3C0"
                                                                        BorderBrush="#FFB800"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Padding="4"
                                                                        Visibility="{Binding Type, Converter={StaticResource AnnotationTypeToCommentVisibilityConverter}}">
                                                                                <StackPanel>
                                                                                    <!-- Comment icon/indicator -->
                                                                                    <TextBlock Text="💬" FontSize="16" HorizontalAlignment="Center"/>
                                                                                    <!-- Expanded content callout box -->
                                                                                    <Border Background="White"
                                                                                BorderBrush="#FFB800"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Margin="0,4,0,0"
                                                                                Padding="8"
                                                                                MinWidth="150"
                                                                                MaxWidth="250"
                                                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <StackPanel>
                                                                                            <TextBlock Text="{Binding Text}"
                                                                                           TextWrapping="Wrap"
                                                                                           FontSize="12"
                                                                                           Foreground="#333333"/>
                                                                                            <TextBlock Text="{Binding CreatedAt, StringFormat='Added: {0:g}'}"
                                                                                           FontSize="9"
                                                                                           Foreground="#888888"
                                                                                           Margin="0,4,0,0"/>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <!-- Other annotation types (non-comment) -->
                                                                            <ContentPresenter Content="{Binding}" 
                                                                                  Visibility="{Binding Type, Converter={StaticResource AnnotationTypeToCommentVisibilityConverter}, ConverterParameter=Invert}"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </InkCanvas.Children>
                                                    </InkCanvas>
                                                </Grid>
                                            </ScrollViewer>
                            
                                            <!-- Continuous Scroll View (all pages like thumbnail panel) -->
                                            <ScrollViewer x:Name="ContinuousScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Visible"
                                              Visibility="{Binding IsContinuousViewMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Background="#F0F0F0"
                                              Padding="20"
                                              CanContentScroll="False"
                                              PreviewMouseWheel="OnContinuousScrollViewerMouseWheel">
                                                <ItemsControl ItemsSource="{Binding PageThumbnails}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White"
                                                        BorderBrush="#CCCCCC"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Margin="0,0,0,20"
                                                        HorizontalAlignment="Center">
                                                                <Border.LayoutTransform>
                                                                    <ScaleTransform ScaleX="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                      ScaleY="{Binding DataContext.ZoomLevel, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                                                                </Border.LayoutTransform>
                                                                <StackPanel MaxWidth="800">
                                                                    <!-- Page number header -->
                                                                    <Border Background="#F5F5F5"
                                                                BorderBrush="#CCCCCC"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="12,8">
                                                                        <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"/>
                                                                    </Border>
                            
                                                                    <!-- Full-size page image -->
                                                                    <Image Source="{Binding PageFullImage}"
                                                               Stretch="Uniform"
                                                               Width="800"
                                                               Margin="0"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                            
                                            <!-- Empty State with Recent Documents -->
                                            <StackPanel VerticalAlignment="Center" 
                                            HorizontalAlignment="Center"
                                            MaxWidth="600"
                                            Visibility="{Binding IsPdfLoaded, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <TextBlock Text="✏️" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                                <TextBlock Text="PDF Editor"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                                <TextBlock Text="Open a PDF to start annotating, drawing, and editing"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,24"/>
                            
                                                <!-- File Drop Zone -->
                                                <Border Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="2"
                                            CornerRadius="12"
                                            Padding="40,32"
                                            Margin="0,0,0,24"
                                            AllowDrop="True"
                                            Drop="OnFileDrop"
                                            DragOver="OnDragOver">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                        <TextBlock Text="Drag and drop PDF here"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,8"/>
                                                        <TextBlock Text="or"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4"/>
                                                    </StackPanel>
                                                </Border>
                            
                                                <Button Content="📂 Open PDF File"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding OpenPdfCommand}"
                                            Padding="24,12"
                                            FontSize="16"
                                            Margin="0,0,0,32"/>
                            
                                                <!-- Recent Documents -->
                                                <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Visibility="{Binding RecentDocuments.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <TextBlock Text="Recent Documents"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,12"/>
                                                        <ItemsControl ItemsSource="{Binding RecentDocuments}" MaxHeight="300">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button Grid.Column="0"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.OpenRecentDocumentCommand, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                    CommandParameter="{Binding}"
                                                                    HorizontalContentAlignment="Left"
                                                                    Padding="12,8">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" 
                                                                               Text="📄" 
                                                                               FontSize="18" 
                                                                               Margin="0,0,12,0"
                                                                               VerticalAlignment="Center"/>
                                                                                <StackPanel Grid.Column="1">
                                                                                    <TextBlock Text="{Binding FileName}"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                   FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                                    <TextBlock Text="{Binding FilePath}"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   FontSize="10"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Button>
                                                                        <Button Grid.Column="1"
                                                                    Content="✕"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveRecentDocumentCommand, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="8,4"
                                                                    Margin="4,0,0,0"
                                                                    ToolTip="Remove from recent"
                                                                    FontSize="12"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                            
                            
                                    </Grid>
                            
                                    <!-- Compact Status Bar -->
                                    <Border Grid.Row="2" 
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                            
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding StatusMessage}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                            
                                            <TextBlock Grid.Column="1"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0">
                                                <Run Text="Tool: "/>
                                                <Run Text="{Binding CurrentToolName}" FontWeight="SemiBold"/>
                                            </TextBlock>
                            
                                            <TextBlock Grid.Column="2"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0">
                                                <Run Text="{Binding ZoomLevel, StringFormat={}{0:P0}}"/>
                                            </TextBlock>
                            
                                            <TextBlock Grid.Column="3"
                                                       Text="🔒 Local"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       ToolTip="All editing happens locally on your device"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Processing Overlay -->
                <Border Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#CC000000">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar Width="300" Height="8"
                                     Value="{Binding ProgressValue}"
                                     Maximum="100"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     Background="{StaticResource CardBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        </Grid>

        <!-- Status Bar (Hidden when PDF Editor is active) -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTool.ToolType}" Value="PdfEditor">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="🔒 Local processing"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           ToolTip="All processing happens on your device"/>
            </Grid>
        </Border>
    </Grid>
</Window>
