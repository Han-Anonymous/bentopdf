<Window x:Class="PDFKawankasi.Views.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PDFKawankasi.ViewModels"
        mc:Ignorable="d"
        Title="Print"
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#303030"
        TextElement.Foreground="#FFFFFF"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="Segoe UI">
    
    <Window.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#303030"
            CornerRadius="0"
            Margin="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/> <!-- Settings Panel -->
                <ColumnDefinition Width="*"/>   <!-- Preview Panel -->
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Settings -->
            <Grid Grid.Column="0" Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Print"
                               FontSize="24"
                               FontWeight="SemiBold"/>

                    <!-- Close Button -->
                    <Button Grid.Column="1"
                            Command="{Binding CancelCommand}"
                            Content="✕"
                            ToolTip="Close"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Padding="8"/>
                </Grid>

                <!-- Settings Form -->
                <StackPanel Grid.Row="1">
                    <!-- Printer -->
                    <TextBlock Text="Printer" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding AvailablePrinters}"
                              SelectedItem="{Binding SelectedPrinter}"
                              Margin="0,0,0,24"/>

                    <!-- Copies -->
                    <TextBlock Text="Copies" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Copies}" 
                             Width="120" 
                             HorizontalAlignment="Left" 
                             Margin="0,0,0,32"/>

                    <!-- Pages -->
                    <TextBlock Text="Pages" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <StackPanel Margin="0,0,0,0">
                        <RadioButton GroupName="PageRange" 
                                     IsChecked="{Binding PrintAllPages}" 
                                     Content="All pages" 
                                     Margin="0,0,0,12"/>
                        
                        <RadioButton GroupName="PageRange" 
                                     IsChecked="{Binding PrintCurrentPage}" 
                                     Content="Current page only" 
                                     Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <RadioButton GroupName="PageRange" 
                                         IsChecked="{Binding PrintCustomRange}" 
                                         Content="Custom range:" 
                                         VerticalAlignment="Center"/>
                            
                            <TextBox Grid.Column="1"
                                     Text="{Binding CustomPageRange}" 
                                     IsEnabled="{Binding PrintCustomRange}" 
                                     Margin="16,0,0,0" 
                                     VerticalAlignment="Center"
                                     ToolTip="e.g. 1-5, 8"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Footer Actions -->
                <StackPanel Grid.Row="2" Margin="0,32,0,0">
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="11"
                               Opacity="0.7"
                               TextTrimming="CharacterEllipsis" 
                               Margin="0,0,0,16"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" 
                                Command="{Binding CancelCommand}" 
                                Padding="20,8"
                                Margin="0,0,8,0"/>
                        
                        <Button Content="Print" 
                                Command="{Binding PrintCommand}" 
                                Padding="20,8"
                                Background="#6200EA"
                                Foreground="White"
                                BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Right Panel: Preview -->
            <Border Grid.Column="1" 
                    Background="White" 
                    BorderBrush="White" 
                    BorderThickness="1,0,0,0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Preview Header -->
                    <Border Background="#424242" Padding="16">
                        <TextBlock Text="Preview" FontSize="14" FontWeight="Medium" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Preview Content -->
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding PreviewPages}" 
                                 Background="White" 
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Center"
                                 Padding="32">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,24" 
                                            CornerRadius="0" 
                                            BorderBrush="#E0E0E0" 
                                            BorderThickness="1">
                                        <Image Source="{Binding}" Stretch="Uniform" MaxWidth="450"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Loading Indicator -->
                        <Grid Visibility="{Binding IsLoadingPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Value="0" Width="200" Height="20" Foreground="#B39DDB"/>
                                <TextBlock Text="Generating preview..." Foreground="#FFFFFF" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
